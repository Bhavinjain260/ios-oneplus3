+static bool
+wl_bringup(void)
+{
+	wl_gcc = wl_map(WL_GCC_PA, 0x90000);
+	wl_parf = wl_map(WL_PARF_PA, 0x2000);
+	wl_phy = wl_map(WL_PHY_PA, 0x4000);
+	wl_dbi = wl_map(WL_DBI_PA, 0x1000);
+	wl_conf = wl_map(WL_CONF_PA, 0x1000);
+	wl_perst = wl_map(WL_TLMM_PA + 0x1000u * WL_GPIO_PERST, 0x1000);
+	wl_boot = wl_map(WL_TLMM_PA + 0x1000u * WL_GPIO_BOOT, 0x1000);
+	wl_clkreq = wl_map(WL_TLMM_PA + 0x1000u * WL_GPIO_CLKREQ, 0x1000);
+	wl_wake = wl_map(WL_TLMM_PA + 0x1000u * WL_GPIO_WAKE, 0x1000);
+	if (!wl_gcc || !wl_parf || !wl_phy || !wl_dbi || !wl_conf || !wl_perst || !wl_boot || !wl_clkreq || !wl_wake) {
+		printf("SAILFISH WLAN: mapping failed\n");
+		return false;
+	}
+	/* Only TLMM and GCC here: PARF/PHY/DBI hang the bus until their clocks run. */
+	printf("SAILFISH WLAN: before: perst cfg %#x io %#x, boot cfg %#x io %#x, gdsc pcie0 %#x aggre0 %#x\n",
+	    rd(wl_perst, 0), rd(wl_perst, 4), rd(wl_boot, 0), rd(wl_boot, 4),
+	    rd(wl_gcc, GCC_PCIE_0_GDSCR), rd(wl_gcc, GCC_AGGRE0_NOC_GDSCR));
+	wl_step("rails");
+
+	/* PCIe endpoint held in reset while everything powers up; CLKREQ# and WAKE# as in pcie0 pinctrl "default". */
+	wl_tlmm_out(wl_perst, 0, 2, 1);
+	wr(wl_clkreq, 0, (1u << 2) | 3u);       /* pci_e0, 2 mA, pull-up */
+	wr(wl_wake, 0, 3u);                     /* GPIO input, 2 mA, pull-up */
+	printf("SAILFISH WLAN: clkreq cfg %#x, wake cfg %#x\n", rd(wl_clkreq, 0), rd(wl_wake, 0));
+	wl_msleep(1);
+
+	/* Rails and the reference clock. */
+	(void)sweet_rpm_smpa(3, 1300000);       /* vdd-wlan-core */
+	(void)sweet_rpm_smpa(4, 1800000);       /* vdd-wlan-io */
+	delay(1000);
+	(void)sweet_rpm_ldoa(30, 1800000);      /* WLAN xtal */
+	(void)sweet_rpm_ldoa(12, 1800000);      /* PCIe PHY 1.8 V */
+	(void)sweet_rpm_ldoa(28, 925000);       /* PCIe PHY 0.9 V */
+	(void)sweet_rpm_xo_buffer(8);           /* LN_BB_CLK */
+
+	/* The chip: vdd-wlan, sleep clock, bootstrap, WLAN_EN. */
+	wl_step("chip power");
+	{
+		/* DT gpio@d100: output, vin-sel 2, src-sel 3 (func2 = SLEEP_CLK2), out-strength 2, CMOS */
+		uint8_t m = 0, v = 0, o = 0, e = 0;
+		(void)sweet_pmic_read(WL_PMIC_SLEEP, 0x40, &m);
+		(void)sweet_pmic_read(WL_PMIC_SLEEP, 0x41, &v);
+		(void)sweet_pmic_read(WL_PMIC_SLEEP, 0x45, &o);
+		(void)sweet_pmic_read(WL_PMIC_SLEEP, 0x46, &e);
+		bool ok = sweet_pmic_write(WL_PMIC_SLEEP, 0x41, 2) && sweet_pmic_write(WL_PMIC_SLEEP, 0x45, 0x02) &&
+		    sweet_pmic_write(WL_PMIC_SLEEP, 0x40, (1u << 4) | (3u << 1)) && sweet_pmic_write(WL_PMIC_SLEEP, 0x46, 0x80);
+		uint8_t m2 = 0;
+		(void)sweet_pmic_read(WL_PMIC_SLEEP, 0x40, &m2);
+		printf("SAILFISH WLAN: PMIC sleep_clk (ppid %#x): mode %#x vin %#x out %#x en %#x -> mode %#x: %s\n",
+		    WL_PMIC_SLEEP, m, v, o, e, m2, ok ? "on" : "WRITE FAILED");
+	}
+	if (!wl_pmic_gpio_high("rome_vreg", WL_PMIC_ROME, 0, 5)) {    /* DT: vin-sel 0 */
+		return false;
+	}
+	/*
+	 * A clean reset of the chip first. Linux's qpnp-pin applies the DT at
+	 * ~0.5 s, so WLAN_EN is a driven-low output long before cnss raises it
+	 * (TWRP: link up at 3.2 s). ABL leaves it an input with a 10 uA
+	 * pull-down while vdd-wlan is already on: hold it (and bootstrap) low.
+	 */
+	{
+		bool ok = sweet_pmic_write(WL_PMIC_EN, 0x41, 2) && sweet_pmic_write(WL_PMIC_EN, 0x42, 4) &&
+		    sweet_pmic_write(WL_PMIC_EN, 0x40, 0x10) && sweet_pmic_write(WL_PMIC_EN, 0x46, 0x80);
+		wl_tlmm_out(wl_boot, 0, 16, 1);
+		printf("SAILFISH WLAN: wlan_en and bootstrap held low: %s\n", ok ? "ok" : "WRITE FAILED");
+		wl_msleep(100);
+	}
+	wl_tlmm_out(wl_boot, 1, 16, 1);         /* cnss_default: gpio, pull-down, driven high */
+	wl_msleep(10);
+	if (!wl_pmic_gpio_high("wlan_en", WL_PMIC_EN, 2, 4)) {      /* DT: vin-sel 2 (1.8 V), pull 4 (down) */
+		return false;
+	}
+	wl_msleep(10);
+
+	/* Power domains, clocks, resets. */
+	wl_step("gdsc + clocks");
+	if (!wl_gdsc("aggre0_noc", GCC_AGGRE0_NOC_GDSCR) || !wl_gdsc("pcie_0", GCC_PCIE_0_GDSCR)) {
+		return false;
+	}
+	(void)wl_branch("aggre0_snoc_axi", GCC_AGGRE0_SNOC_AXI_CBCR, true);
+	(void)wl_branch("aggre0_cnoc_ahb", GCC_AGGRE0_CNOC_AHB_CBCR, true);
+	(void)wl_branch("smmu_aggre0_axi", GCC_SMMU_AGGRE0_AXI_CBCR, true);
+	(void)wl_branch("smmu_aggre0_ahb", GCC_SMMU_AGGRE0_AHB_CBCR, true);
+	/* aux 1.0105 MHz = XO / 19: RCG MND, src 0 (XO), hid div 1, M 1, N 19, dual edge */
+	wr(wl_gcc, GCC_PCIE_AUX_CMD_RCGR + 0x8, 1);                      /* M */
+	wr(wl_gcc, GCC_PCIE_AUX_CMD_RCGR + 0xc, ~(19u - 1u));             /* N: ~(n - m) */
+	wr(wl_gcc, GCC_PCIE_AUX_CMD_RCGR + 0x10, ~19u);                   /* D: ~n (50 %) */
+	wr(wl_gcc, GCC_PCIE_AUX_CMD_RCGR + 0x4, (2u << 12) | (0u << 8) | 1u);   /* CFG */
+	wr(wl_gcc, GCC_PCIE_AUX_CMD_RCGR, rd(wl_gcc, GCC_PCIE_AUX_CMD_RCGR) | 1u);
+	for (int i = 0; i < 100 && (rd(wl_gcc, GCC_PCIE_AUX_CMD_RCGR) & 1u); i++) {
+		delay(5);
+	}
+	bool clk = wl_branch("pcie_0_aux", GCC_PCIE_0_AUX_CBCR, true);
+	clk &= wl_branch("pcie_0_cfg_ahb", GCC_PCIE_0_CFG_AHB_CBCR, true);
+	clk &= wl_branch("pcie_0_mstr_axi", GCC_PCIE_0_MSTR_AXI_CBCR, true);
+	clk &= wl_branch("pcie_0_slv_axi", GCC_PCIE_0_SLV_AXI_CBCR, true);
+	clk &= wl_branch("pcie_phy_cfg_ahb", GCC_PCIE_PHY_CFG_AHB_CBCR, true);
+	clk &= wl_branch("pcie_phy_aux", GCC_PCIE_PHY_AUX_CBCR, true);
+	(void)wl_branch("pcie_clkref", GCC_PCIE_CLKREF_EN, false);
+	if (!clk) {
+		return false;
+	}
+	/* PHY resets pulsed (mainline qcom_qmp: assert, then deassert). */
+	printf("SAILFISH WLAN: BCRs phy %#x com %#x nocsr %#x lane %#x, clkref %#x\n",
+	    rd(wl_gcc, GCC_PCIE_PHY_BCR), rd(wl_gcc, GCC_PCIE_PHY_COM_BCR),
+	    rd(wl_gcc, GCC_PCIE_PHY_NOCSR_COM_PHY_BCR), rd(wl_gcc, GCC_PCIE_0_PHY_BCR), rd(wl_gcc, GCC_PCIE_CLKREF_EN));
+	wr(wl_gcc, GCC_PCIE_PHY_BCR, 1);
+	wr(wl_gcc, GCC_PCIE_PHY_COM_BCR, 1);
+	wr(wl_gcc, GCC_PCIE_PHY_NOCSR_COM_PHY_BCR, 1);
+	wr(wl_gcc, GCC_PCIE_0_PHY_BCR, 1);
+	wl_msleep(1);
+	wr(wl_gcc, GCC_PCIE_PHY_BCR, 0);
+	wr(wl_gcc, GCC_PCIE_PHY_COM_BCR, 0);
+	wr(wl_gcc, GCC_PCIE_PHY_NOCSR_COM_PHY_BCR, 0);
+	wl_msleep(1);
+
+	/* Controller glue. */
+	wl_step("parf");
+	wr(wl_parf, PARF_PHY_CTRL, rd(wl_parf, PARF_PHY_CTRL) & ~1u);
+	wr(wl_parf, PARF_DBI_BASE_ADDR, 0);
+	wr(wl_parf, PARF_SYS_CTRL, 0x365e);
+	wr(wl_parf, PARF_MHI_CLOCK_RESET_CTRL, rd(wl_parf, PARF_MHI_CLOCK_RESET_CTRL) | (1u << 4));
+	wr(wl_parf, PARF_SLV_ADDR_SPACE_SIZE, 16u << 20);       /* bars 0xc300000 + 13 MB */
+
+	/* PHY, pipe clock (comes from the PHY), PHY ready. */
+	wl_step("phy");
+	wl_phy_common();
+	wl_msleep(1);
+	wr(wl_gcc, GCC_PCIE_0_PHY_BCR, 0);
+	(void)wl_branch("pcie_0_pipe", GCC_PCIE_0_PIPE_CBCR, false);
+	bool ready = false;
+	for (int i = 0; i < 10 && !ready; i++) {
+		ready = (rd(wl_phy, PCIE_COM_PCS_READY_STATUS) & 1u) != 0;
+		if (!ready) {
+			wl_msleep(1);
+		}
+	}
+	printf("SAILFISH WLAN: PHY %s (ready %#x, pipe cbcr %#x, C_READY %#x)\n", ready ? "ready" : "NOT READY",
+	    rd(wl_phy, PCIE_COM_PCS_READY_STATUS), rd(wl_gcc, GCC_PCIE_0_PIPE_CBCR), rd(wl_phy, 0x190));
+	if (!ready) {
+		return false;
+	}
+	wl_phy_port();
+	/* Lane up: PCS_STATUS PHYSTATUS (bit 6) clears once the pipe clock runs (mainline qmp power_on). */
+	uint32_t pcs = 0;
+	for (int i = 0; i < 100; i++) {
+		pcs = rd(wl_phy, PCS_ + 0x174);
+		if (!(pcs & (1u << 6))) {
+			break;
+		}
+		delay(100);
+	}
+	printf("SAILFISH WLAN: lane %s (pcs status %#x, pipe cbcr %#x, com ready %#x)\n",
+	    (pcs & (1u << 6)) ? "NOT UP" : "up", pcs, rd(wl_gcc, GCC_PCIE_0_PIPE_CBCR), rd(wl_phy, PCIE_COM_PCS_READY_STATUS));
+	wl_msleep(10);                          /* qcom,ep-latency */
+
+	/* Endpoint out of reset, link training. */
+	wl_step("link");
+	wl_tlmm_out(wl_perst, 1, 2, 1);
+	wl_msleep(1);
+	wr(wl_dbi, DBI_DEVICE_CONTROL_STATUS,
+	    (rd(wl_dbi, DBI_DEVICE_CONTROL_STATUS) & ~0x7000u) | (5u << 12));      /* max read 4 KB */
+	wr(wl_parf, PARF_LTSSM, rd(wl_parf, PARF_LTSSM) | (1u << 8));
+	uint32_t sts = 0, lnk = 0, ltssm = 0xff, seen = 0;
+	bool up = false;
+	for (int i = 0; i < 1000 && !up; i++) {         /* 1 s, like mainline dw_pcie_wait_for_link */
+		delay(1000);
+		sts = rd(wl_dbi, ELBI_SYS_STTS);
+		lnk = rd(wl_dbi, DBI_LINK_STATUS);
+		up = (sts & XMLH_LINK_UP) && (lnk & (1u << 29));
+		uint32_t st = rd(wl_dbi, 0x728) & 0x3fu;        /* PORT_DEBUG0: LTSSM state */
+		if (st != ltssm && seen++ < 24) {
+			printf("SAILFISH WLAN: LTSSM %#x at %d ms (debug1 %#x, clkreq in %u, wake in %u)\n", st, i,
+			    rd(wl_dbi, 0x72c), (rd(wl_clkreq, 4) & 1u), (rd(wl_wake, 4) & 1u));
+		}
+		ltssm = st;
+	}
+	printf("SAILFISH WLAN: link %s after PERST (elbi %#x, link status %#x, ltssm %#x, rc id %#x, perst io %#x, pcs status %#x, pipe cbcr %#x)\n",
+	    up ? "UP" : "DOWN", sts, lnk, rd(wl_parf, PARF_LTSSM), rd(wl_dbi, 0), rd(wl_perst, 4),
+	    rd(wl_phy, PCS_ + 0x174), rd(wl_gcc, GCC_PCIE_0_PIPE_CBCR));
+	if (!up) {
+		return false;
+	}
+
+	wl_step("config space");
+	/* iATU region 0: CFG0 accesses to bus 1, device 0 through the conf window. */
+	wr(wl_dbi, DBI_IATU_VIEWPORT, 0);
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x8, 0);                 /* CTRL2: off */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x4, 0x04);              /* CTRL1: CFG0 */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0xc, WL_CONF_PA);        /* LBAR */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x10, 0);                /* UBAR */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x14, WL_CONF_PA + 0xfff);       /* LAR */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x18, 1u << 24);         /* LTAR: bus 1 */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x1c, 0);                /* UTAR */
+	wr(wl_dbi, DBI_IATU_VIEWPORT + 0x8, 1u << 31);          /* enable */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t id = rd(wl_conf, 0), rev = rd(wl_conf, 8);
+	printf("SAILFISH WLAN: endpoint id %#x class/rev %#x bar0 %#x%s\n", id, rev, rd(wl_conf, 0x10),
+	    id == 0x003e168cu ? " = QCA6174" : "");
+	return id == 0x003e168cu;
+}
+
+static void
+wl_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	wl_msleep(20000);       /* after boot: the log thread runs, iOS is up */
+	bool ok = wl_bringup();
+	printf("SAILFISH WLAN: stage 1 %s\n", ok ? "done: QCA6174 on PCIe" : "FAILED");
+	thread_terminate(current_thread());
+}
+
+void
+sailfish_wlan_init(void)
+{
+	int on = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("sailfishwlan", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (kernel_thread_start(wl_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
