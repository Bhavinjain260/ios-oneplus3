+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+}
+
+static void
+wl_msleep(uint32_t ms)
+{
+	delay(ms * 1000);
+}
+
+/*
+ * Bring-up trace: log, get it onto the disk, then go on. A bus hang on an
+ * unclocked register resets the phone (and ABL then boots Android, so the
+ * RAM console is lost): the persistent log is the only trace.
+ */
+static void
+wl_step(const char *what)
+{
+	printf("SAILFISH WLAN: step %s\n", what);
+	sweet_log_kick();
+	wl_msleep(300);
+}
+
+/* Map pa..pa+size (page-rounded); 0 on failure. */
+static vm_offset_t
+wl_map(uint64_t pa, uint32_t size)
+{
+	vm_offset_t va = ml_io_map(trunc_page_64(pa), round_page_64(size + (pa & PAGE_MASK)));
+	return va ? va + (pa & PAGE_MASK) : 0;
+}
+
+/* Branch clock on: CBCR bit 0, wait for CLK_OFF (bit 31) to clear. */
+static bool
+wl_branch(const char *name, uint32_t off, bool halt_check)
+{
+	wr(wl_gcc, off, rd(wl_gcc, off) | 1u);
+	for (int i = 0; halt_check && i < 200; i++) {
+		if (!(rd(wl_gcc, off) & (1u << 31))) {
+			return true;
+		}
+		delay(5);
+	}
+	if (halt_check) {
+		printf("SAILFISH WLAN: clock %s stays off (cbcr %#x)\n", name, rd(wl_gcc, off));
+	}
+	return !halt_check;
+}
+
+/* GDSC on: SW_COLLAPSE (bit 0) off, wait for PWR_ON (bit 31). */
+static bool
+wl_gdsc(const char *name, uint32_t off)
+{
+	uint32_t v = rd(wl_gcc, off);
+	wr(wl_gcc, off, v & ~1u);
+	for (int i = 0; i < 200; i++) {
+		if (rd(wl_gcc, off) & (1u << 31)) {
+			printf("SAILFISH WLAN: GDSC %s on (%#x -> %#x)\n", name, v, rd(wl_gcc, off));
+			return true;
+		}
+		delay(5);
+	}
+	printf("SAILFISH WLAN: GDSC %s FAILED (%#x -> %#x)\n", name, v, rd(wl_gcc, off));
+	return false;
+}
+
+/* TLMM pin as a GPIO output at level, drive (mA), pull (0 none, 1 down, 3 up). */
+static void
+wl_tlmm_out(vm_offset_t tile, unsigned level, unsigned ma, unsigned pull)
+{
+	wr(tile, 4, level ? 2u : 0u);                           /* IN_OUT: output value */
+	wr(tile, 0, (1u << 9) | ((ma / 2 - 1) << 6) | pull);    /* OE, drive, func 0 */
+}
+
+/*
+ * PMIC GPIO (PM8994) driven high as the live DT configures it (qpnp-pin):
+ * the output level comes from VIN_CTL (0x41), so the voltage source and
+ * the pull are set before the pin turns into an output.
+ * MODE_CTL: mode [6:4] = 1 digital output, source [3:1] = 0, invert bit 0.
+ */
+static bool
+wl_pmic_gpio_high(const char *name, uint16_t ppid, uint8_t vin, uint8_t pull)
+{
+	uint8_t mode = 0, vin0 = 0, pull0 = 0, en = 0, out = 0;
+	(void)sweet_pmic_read(ppid, 0x40, &mode);
+	(void)sweet_pmic_read(ppid, 0x41, &vin0);
+	(void)sweet_pmic_read(ppid, 0x42, &pull0);
+	(void)sweet_pmic_read(ppid, 0x45, &out);
+	(void)sweet_pmic_read(ppid, 0x46, &en);
+	/* Already a high output (ABL sets rome_vreg up): leave it as it is. */
+	bool ok = (mode == 0x11 && (en & 0x80)) ||
+	    (sweet_pmic_write(ppid, 0x41, vin) && sweet_pmic_write(ppid, 0x42, pull) &&
+	    sweet_pmic_write(ppid, 0x40, 0x11) && sweet_pmic_write(ppid, 0x46, 0x80));
+	uint8_t after = 0, vin1 = 0;
+	(void)sweet_pmic_read(ppid, 0x40, &after);
+	(void)sweet_pmic_read(ppid, 0x41, &vin1);
+	printf("SAILFISH WLAN: PMIC %s (ppid %#x): mode %#x vin %#x pull %#x out %#x en %#x -> mode %#x vin %#x: %s\n",
+	    name, ppid, mode, vin0, pull0, out, en, after, vin1, ok ? "high" : "WRITE FAILED");
+	return ok;
+}
