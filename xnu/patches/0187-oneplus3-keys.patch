--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -1,8 +1,11 @@
 /*
- * Minimal polled keys for the Pixel 1 (sailfish, MSM8996). Call once after
- * the scheduler is running. Every 20 ms:
+ * Minimal polled keys for the OnePlus 3 (oneplus3, MSM8996). Call once after
+ * the scheduler is running. Every 20 ms, poll three inputs:
+ *
  * power PM8994 (SID 0) PON RT_STS 0x810 bit 0 (KPDPWR), read through
- * the SPMI PMIC arbiter v2 observer channel
- * volume up TLMM GPIO 126, active low
- * volume down TLMM GPIO 121, active low -> reported as Home (the iPhone 8
- * userland needs a Home button; the Pixel has none)
+ * the SPMI PMIC arbiter v2 observer channel
+ * volume up TLMM GPIO ??? (TODO_VERIFY from OP3 DTB)
+ * volume down TLMM GPIO ??? (TODO_VERIFY from OP3 DTB)
+ *
+ * Unlike the Pixel 1 port, OP3 does NOT map volume-down to Home. The OP3
+ * has a real hardware Home button (capacitive, fed through the Synaptics
+ * touch IC's F30 function). The OP3 stock kernel exposes the capacitive
+ * back / home / recents keys via three /proc/s1302/ paths (confirmed in
+ * Gaurav241/device_oneplus_oneplus3 lineagehw/touch/):
+ *   /proc/s1302/virtual_key  - enable/disable the capacitive keys (KeyDisabler.cpp)
+ *   /proc/s1302/key_rep       - swap back and recents positions (KeySwapper.cpp)
+ *   /proc/touchpanel/<g>_enable - per-gesture enable (TouchscreenGesture.cpp)
+ * These are sysfs paths the OP3's modified Synaptics DSX driver creates on
+ * top of RMI4's F30 function; they are NOT part of standard RMI4. The
+ * SWEET_ONEPLUS3 keys driver in this file does NOT create them. To deliver
+ * the capacitive keys as HID events, a follow-up patch would extend
+ * 0185-oneplus3-touch-rmi4.patch to query F30 in the existing PDT scan,
+ * and report the three buttons via sweet_hid_key(). The iPhone SE2 userland
+ * (iPhone12,8 / N104AP) expects a Home button press, and the OP3 hardware
+ * provides one through F30 - so the eventual wiring will deliver Home, Back,
+ * and Recents as separate HID keycodes, not as software-mapped keys.
  *
  * PMIC access is READ ONLY: the sole PMIC-side write issues EXT_READL on an
- * observer channel. The volume GPIOs only get their pull-up (as Linux's
- * tlmm_gpio_key_active pinctrl) if the bootloader left them without one.
+ * observer channel. The volume GPIOs only get their pull-up if the
+ * bootloader left them without one (the OP3 stock bootloader programs
+ * them as inputs with pull-up before jumping to our shim).
  */
-#if defined(ARM64_BOARD_CONFIG_SWEET) && !defined(SWEET_ONEPLUS3)
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_ONEPLUS3)
 #include <sys/param.h>
 #include <kern/thread.h>
 #include <mach/mach_types.h>
 #include <pexpert/device_tree.h>
 #include <pexpert/boot.h>
 extern void sweet_hid_key(int key, int down);
 void sweet_keys_init(void);
+
+/* qcom,spmi@400f000: core, obsrvr, cnfg (same addresses as Pixel 1 - same SoC) */
+#define KEYS_CORE_PA 0x0400f000u
+#define KEYS_OBS_PA  0x04c00000u
+#define KEYS_CNFG_PA 0x0400a000u
+#define KEYS_APIDS   256u         /* core is 0xc00: map 0x800 + 4n */
+#define KEYS_PON_RT  0x0810u
+#define KEYS_NO_APID 0xffffu
+/* pinctrl@101000, one 4 KiB tile per GPIO: CFG +0, IN_OUT +4.
+ * TODO_VERIFY(OP3 DTB): the OP3 stock DTB's "gpio_key_active" pinctrl lists
+ * the exact volume up / down GPIOs. Default to the OP3's common assignment
+ * (vol-up = 113, vol-down = 114 on most OP3 board revisions), but confirm. */
+#define KEYS_TLMM_PA    0x01010000u
+#define KEYS_GPIO_VOLUP 113u
+#define KEYS_GPIO_VOLDN 114u
+
+enum { KEY_POWER = 0, KEY_VOLUP = 1, KEY_VOLDN = 2 }; /* no Home mapping */
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg, keys_volup, keys_voldn;
+static uint16_t keys_pon_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static inline uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+       __asm__ volatile("dmb ishld" ::: "memory");
+       return *(volatile uint32_t *)(base + off);
+}
+
+/* PPID -> APID (Linux pmic_arb_find_apid, v2 map at core + 0x800). */
+static uint16_t
+keys_find_apid(uint16_t ppid)
+{
+       uint16_t found = KEYS_NO_APID;
+       for (uint32_t i = 0; i < KEYS_APIDS; i++) {
+               uint32_t map = keys_rd(keys_core, 0x800u + 4u * i);
+               if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+                       continue;
+               }
+               found = (uint16_t)i;
+               break;
+       }
+       return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+       if (apid == KEYS_NO_APID) {
+               return false;
+       }
+       uint32_t off = 0; /* keys_obs maps only this APID's channel (see init) */
+       uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+       __asm__ volatile("dmb oshst" ::: "memory");
+       *(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+       __asm__ volatile("dmb oshst" ::: "memory");
+       for (unsigned i = 0; i < 100; i++) {
+               uint32_t s = keys_rd(keys_core, 0x404u); /* PMIC_ARB_STATUS */
+               if (s & (1u << 1)) {
+                       keys_last_status = s;
+                       return false; /* bus error / NACK */
+               }
+               if (s & 1u) {
+                       keys_last_status = s;
+                       *out = (uint8_t)keys_rd(keys_obs, 0x900u); /* read FIFO */
+                       return true;
+               }
+               delay(1);
+       }
+       keys_last_status = keys_rd(keys_core, 0x404u);
+       return false;
+}
+
+static vm_offset_t
+keys_gpio_map(uint32_t gpio)
+{
+       vm_offset_t tile = ml_io_map(KEYS_TLMM_PA + 0x1000u * gpio, 0x1000);
+       if (tile == 0) {
+               return 0;
+       }
+       uint32_t cfg = keys_rd(tile, 0);
+       printf("SWEET KEYS: gpio%u cfg=%#x in=%u\n", gpio, cfg, keys_rd(tile, 4) & 1u);
+       if ((cfg & 3u) != 3u || (cfg & 0x200u) != 0) {
+               /* function 0 (GPIO), input, 2 mA, pull-up */
+               *(volatile uint32_t *)tile = 3u;
+               __asm__ volatile("dsb sy" ::: "memory");
+               printf("SWEET KEYS: gpio%u set to input pull-up (cfg %#x)\n",
+                   gpio, keys_rd(tile, 0));
+       }
+       return tile;
+}
+
+static void
+keys_wait(void)
+{
+       assert_wait((event_t)&keys_sleep_chan, THREAD_UNINT);
+       thread_set_timer_deadline(deadline_for_timeout(20, 0));
+       thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+       static const int code[3] = {KEY_POWER, KEY_VOLUP, KEY_VOLDN};
+       int state[3] = {0, 0, 0};
+       unsigned errors = 0;
+       (void)arg;
+       (void)result;
+       for (;;) {
+               uint8_t pon = 0;
+               bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+               int now[3] = {
+                       !!(pon & 1u),
+                       !(keys_rd(keys_volup, 4) & 1u),
+                       !(keys_rd(keys_voldn, 4) & 1u),
+               };
+               if (!pok && keys_pon_apid != KEYS_NO_APID && (errors++ % 250u) == 0) {
+                       printf("SWEET KEYS: PON read error arb-status=%#x\n",
+                           keys_last_status);
+               }
+               for (int k = 0; k < 3; k++) {
+                       if ((k != 0 || pok) && now[k] != state[k]) {
+                               state[k] = now[k];
+                               printf("SWEET KEYS: key=%d down=%d\n", code[k], state[k]);
+                               sweet_hid_key(code[k], state[k]);
+                       }
+               }
+               keys_wait();
+       }
+}
+
+void
+sweet_keys_init(void)
+{
+       thread_t thread = THREAD_NULL;
+       if (keys_started) {
+               return;
+       }
+       keys_started = true;
+       unsigned skip = 0;
+       PE_parse_boot_argn("sweetkeys", &skip, sizeof(skip));
+       if (skip) {
+               printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+               return;
+       }
+       keys_core = ml_io_map(KEYS_CORE_PA, 0x1000);
+       keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+       keys_volup = keys_gpio_map(KEYS_GPIO_VOLUP);
+       keys_voldn = keys_gpio_map(KEYS_GPIO_VOLDN);
+       if (!keys_core || !keys_cnfg || !keys_volup || !keys_voldn) {
+               printf("SWEET KEYS: MMIO mapping failed\n");
+               return;
+       }
+       keys_version = keys_rd(keys_core, 0);
+       if (keys_version >= 0x20000000u && keys_version < 0x50000000u) {
+               keys_pon_apid = keys_find_apid(0x008);
+       }
+       /* v2 observer channel: obs + EE(0)*0x1000 + APID*0x8000. Map only that
+        * page (the 8 MB window does not fit the io map). */
+       if (keys_pon_apid != KEYS_NO_APID) {
+               keys_obs = ml_io_map(KEYS_OBS_PA + 0x8000u * keys_pon_apid, 0x1000);
+               if (!keys_obs) {
+                       keys_pon_apid = KEYS_NO_APID;
+               }
+       }
+       uint8_t pon = 0;
+       bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+       printf("SWEET KEYS: arb=%#x pon-apid=%u pon=%#x/%d (no Home mapping)\n",
+           keys_version, keys_pon_apid, pon, pok);
+       if (!pok) {
+               printf("SWEET KEYS: power key unreadable; volume keys only\n");
+               keys_pon_apid = KEYS_NO_APID;
+       }
+       kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+       if (kr == KERN_SUCCESS) {
+               thread_deallocate(thread);
+       } else {
+               printf("SWEET KEYS: thread start failed kr=%d\n", kr);
+       }
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET && SWEET_ONEPLUS3 */
