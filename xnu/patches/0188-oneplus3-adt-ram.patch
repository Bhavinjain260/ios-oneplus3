         add_pixel1(root, args)
     elif args.machine == "pixel1-highmem":
         add_pixel1(root, args)
         add_highmem(root, args)
+    elif args.machine == "oneplus3":
+        add_oneplus3(root, args)
+        add_highmem(root, args)  # OP3 also uses the upper DDR bank
     else:
         add_sweet(root, args)
